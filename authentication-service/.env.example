# Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=auth
DB_USER=authsvc
DB_PASSWORD=changeme

SERVER_PORT=8081

# Service-to-service auth. This service is internal-only: the login API is the
# sole caller. Leave SERVICE_API_KEY blank in dev to disable the check.
SERVICE_API_KEY=

# OTP delivery. 'real' uses SMTP (Mailpit locally, an ESP in production);
# 'logging' prints codes to the log for offline work.
# SMS stays off until a provider and DLT registration are in place.
OTP_SENDER=real
SMS_ENABLED=false
# Local default is the Mailpit container; leave these unset to use it.
# For Resend, take the exact values from its dashboard:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=<your resend api key>
#   SMTP_AUTH=true
#   SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_TLS=
MAIL_FROM=no-reply@dyota.shop
